{
  "name": "tradfal",
  "private": true,
  "description": "Tradfal \u2014 la red social para quienes hacen videojuegos que se juegan en el navegador.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tradfal/web dev",
    "build": "pnpm --filter @tradfal/web build",
    "lint": "pnpm --filter @tradfal/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @tradfal/web --filter @tradfal/gateway test"
  }
}
