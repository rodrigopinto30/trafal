# Tradfal · variables de entorno
# ./start.sh copia este archivo a .env la primera vez. Todo tiene un valor por defecto que funciona en local.

# URL pública del sitio y puerto donde se publica la web.
SITE_URL=http://localhost:3000
# En producción tiene que ser el dominio real (https://…): de ahí salen las direcciones canónicas, el sitemap y las tarjetas. Mientras sea
# localhost, un dominio .local/.test o una dirección de la máquina, robots.txt cierra el sitio por completo para que no se indexe.
WEB_PORT=3000
# La web y los juegos solo se abren desde esta máquina. Para probar desde el celular por la red: WEB_BIND=0.0.0.0 y GAMES_BIND=0.0.0.0
# (todo lo que corre en local queda a la vista de esa red).
WEB_BIND=127.0.0.1
GAMES_BIND=127.0.0.1

# --- Login con Google y con Discord (opcionales) ----------------------------------------------
# Sin las credenciales de uno, su botón queda oculto y el resto del ingreso funciona igual.
# Cómo conseguirlas: docs/DESARROLLO.md → «Login con Google» y «Login con Discord».
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=

# --- Captcha (Cloudflare Turnstile) ------------------------------------------------------------
# Protege el registro y el formulario de reclamos de derechos de autor. Vacío en local: no se muestra y todo funciona igual.
# En un sitio público (SITE_URL con un dominio real) es OBLIGATORIO: sin la clave secreta, el servidor rechaza esos formularios.
# Se crean en el panel de Cloudflare → Turnstile (README → «Captcha»). Para probarlo en local sin cuenta, Cloudflare publica claves
# de prueba: sitio 1x00000000000000000000AA y secreta 1x0000000000000000000000000000000AA (siempre pasa); con la secreta
# 2x0000000000000000000000000000000AA siempre falla.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email de contacto de los documentos legales (opcional) -------------------------------------
# Si lo cargás, los Términos, la Privacidad, las Normas y Derechos de autor lo ofrecen además de los canales del sitio (reportar,
# apelar, reclamar). Vacío, esas frases no aparecen. Es texto público y entra al compilar (argumento de build).
LEGAL_CONTACT_EMAIL=

# Las claves y URLs de Supabase NO se configuran acá: ./start.sh las lee de Supabase y las deja en
# .env.supabase (archivo generado, ignorado por git). Lo mismo vale para el almacenamiento de imágenes en local
# (S3_* y MEDIA_PUBLIC_URL apuntan al S3 de Supabase Storage, que hace de Cloudflare R2).
#
# --- Almacenamiento de imágenes en PRODUCCIÓN (Cloudflare R2) ---------------------------------
# Se cargan como variables de entorno del servidor (por ejemplo en Vercel), nunca en el navegador:
#   S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<token de R2 con permiso de escritura SOLO sobre el bucket de medios>
#   S3_SECRET_ACCESS_KEY=<secreto de ese token>
#   S3_BUCKET_MEDIA=tradfal-media
#   S3_BUCKET_MEDIA_HIDDEN=tradfal-media-hidden    # PRIVADO: ahí van los archivos de lo que la moderación oculta (y vuelven al restaurar)
#   S3_BUCKET_QUARANTINE=tradfal-quarantine       # zips de juegos sin revisar (privado; regla de ciclo de vida: borrar a las 24 h)
#   S3_PUBLIC_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com   # el mismo endpoint, tal como lo ve el NAVEGADOR (firma las subidas)
#   S3_BUCKET_GAMES=tradfal-games                  # la web lo usa solo para borrar los archivos de una cuenta eliminada
#   (el token de R2 también necesita escritura sobre el bucket de cuarentena; CORS del bucket de cuarentena: PUT desde SITE_URL;
#    y listar + borrar objetos en el bucket de juegos, para eliminar cuentas)
#
# --- Worker de juegos en PRODUCCIÓN (contenedor aparte, por ejemplo en Fly.io) ------------------
#   WORKER_DATABASE_URL=postgresql://game_worker:<contraseña>@<host de Postgres>:5432/postgres?sslmode=verify-full&sslrootcert=/ruta/al/ca.crt
#       Con una base remota el worker no arranca sin sslmode=verify-full (el certificado se descarga de Supabase → Database → SSL).
#       El rol game_worker lo crea la migración SIN login: habilitalo una vez con
#       «alter role game_worker with login password '...'». Solo puede llamar a las funciones del esquema «worker».
#   S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY   # mismas variables que la web, con un token de R2 que lea y borre
#                                                                     # en cuarentena y escriba en el bucket de juegos
#   S3_BUCKET_QUARANTINE=tradfal-quarantine
#   S3_BUCKET_GAMES=tradfal-games                                     # privado: solo lo lee el gateway
#
# --- Servidor de juegos (gateway) y dominio de juegos en PRODUCCIÓN --------------------------
#   GAMES_BASE_URL=https://tradfal-games.example    # OTRO dominio registrable, no un subdominio de SITE_URL (pedir su alta en la
#                                                  # Public Suffix List). La web lo recibe como NEXT_PUBLIC_GAMES_BASE_URL al compilar.
#   DNS: un comodín «*.tradfal-games.example» hacia el gateway, con certificado comodín.
#   El gateway necesita: GAMES_BASE_URL, SITE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY y un token de R2 de SOLO LECTURA sobre el
#   bucket de juegos (S3_*). En Cloudflare Workers se lee el bucket por binding en vez de la API S3 (falta ese adaptador).
#   MEDIA_PUBLIC_URL=https://media.tu-dominio.com   # dominio público del bucket (lectura). Tiene que servir X-Content-Type-Options: nosniff
#                                                   # (regla de transformación de Cloudflare: docs/DESARROLLO.md → «Medios en producción»)
#
# --- Clave de los reclamos de derechos de autor en PRODUCCIÓN ---------------------------------------
#   CLAIMS_SERVER_KEY=<64 caracteres al azar, por ejemplo: openssl rand -hex 32>   # solo del servidor de la web, nunca NEXT_PUBLIC_
#   La base solo acepta un reclamo con esta clave (después del captcha). Se carga una vez su SHA-256 en Supabase (SQL Editor):
#     insert into private.server_keys (name, key_sha256) values ('claims', '<printf %s "$CLAIMS_SERVER_KEY" | sha256sum>');
#   En local la genera ./start.sh.
