# Trafal · variables de entorno
# ./start.sh copia este archivo a .env la primera vez. Todo tiene un valor por defecto que funciona en local.

# URL pública del sitio y puerto donde se publica la web.
SITE_URL=http://localhost:3000
WEB_PORT=3000

# --- Login con Google (opcional) --------------------------------------------------------------
# Sin estas credenciales el botón de Google queda oculto y el login con email funciona igual.
# Cómo conseguirlas: README → «Login con Google».
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Las claves y URLs de Supabase NO se configuran acá: ./start.sh las lee de Supabase y las deja en
# .env.supabase (archivo generado, ignorado por git). Lo mismo vale para el almacenamiento de imágenes en local
# (S3_* y MEDIA_PUBLIC_URL apuntan al S3 de Supabase Storage, que hace de Cloudflare R2).
#
# --- Almacenamiento de imágenes en PRODUCCIÓN (Cloudflare R2) ---------------------------------
# Se cargan como variables de entorno del servidor (por ejemplo en Vercel), nunca en el navegador:
#   S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<token de R2 con permiso de escritura SOLO sobre el bucket de medios>
#   S3_SECRET_ACCESS_KEY=<secreto de ese token>
#   S3_BUCKET_MEDIA=trafal-media
#   MEDIA_PUBLIC_URL=https://media.tu-dominio.com   # dominio público del bucket (lectura)
