# Trafal · variables de entorno
# ./start.sh copia este archivo a .env la primera vez. Todo tiene un valor por defecto que funciona en local.

# URL pública del sitio y puerto donde se publica la web.
SITE_URL=http://localhost:3000
WEB_PORT=3000

# --- Login con Google (opcional) --------------------------------------------------------------
# Sin estas credenciales el botón de Google queda oculto y el login con email funciona igual.
# Cómo conseguirlas: README → «Login con Google».
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Las claves y URLs de Supabase NO se configuran acá: ./start.sh las lee de Supabase y las deja en
# .env.supabase (archivo generado, ignorado por git). Lo mismo vale para el almacenamiento de imágenes en local
# (S3_* y MEDIA_PUBLIC_URL apuntan al S3 de Supabase Storage, que hace de Cloudflare R2).
#
# --- Almacenamiento de imágenes en PRODUCCIÓN (Cloudflare R2) ---------------------------------
# Se cargan como variables de entorno del servidor (por ejemplo en Vercel), nunca en el navegador:
#   S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=<token de R2 con permiso de escritura SOLO sobre el bucket de medios>
#   S3_SECRET_ACCESS_KEY=<secreto de ese token>
#   S3_BUCKET_MEDIA=trafal-media
#   S3_BUCKET_QUARANTINE=trafal-quarantine       # zips de juegos sin revisar (privado; regla de ciclo de vida: borrar a las 24 h)
#   S3_PUBLIC_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com   # el mismo endpoint, tal como lo ve el NAVEGADOR (firma las subidas)
#   (el token de R2 también necesita escritura sobre el bucket de cuarentena; CORS del bucket de cuarentena: PUT desde SITE_URL)
#
# --- Worker de juegos en PRODUCCIÓN (contenedor aparte, por ejemplo en Fly.io) ------------------
#   WORKER_DATABASE_URL=postgresql://game_worker:<contraseña>@<host de Postgres>:5432/postgres
#       El rol game_worker lo crea la migración SIN login: habilitalo una vez con
#       «alter role game_worker with login password '...'». Solo puede llamar a las funciones del esquema «worker».
#   S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY   # mismas variables que la web, con un token de R2 que lea y borre
#                                                                     # en cuarentena y escriba en el bucket de juegos
#   S3_BUCKET_QUARANTINE=trafal-quarantine
#   S3_BUCKET_GAMES=trafal-games                                     # privado: solo lo lee el gateway
#
# --- Servidor de juegos (gateway) y dominio de juegos en PRODUCCIÓN --------------------------
#   GAMES_BASE_URL=https://trafal-games.example    # OTRO dominio registrable, no un subdominio de SITE_URL (pedir su alta en la
#                                                  # Public Suffix List). La web lo recibe como NEXT_PUBLIC_GAMES_BASE_URL al compilar.
#   DNS: un comodín «*.trafal-games.example» hacia el gateway, con certificado comodín.
#   El gateway necesita: GAMES_BASE_URL, SITE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY y un token de R2 de SOLO LECTURA sobre el
#   bucket de juegos (S3_*). En Cloudflare Workers se lee el bucket por binding en vez de la API S3 (falta ese adaptador).
#   MEDIA_PUBLIC_URL=https://media.tu-dominio.com   # dominio público del bucket (lectura)
